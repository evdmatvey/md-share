generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Share {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  markdown  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shares")
}
